DATABASE_URL=postgresql+psycopg://tenant_rbac:tenant_rbac@localhost:5432/tenant_rbac
# Uvicorn worker processes. Keep WEB_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW) < Postgres max_connections
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
KEYCLOAK_SERVER_URL=http://localhost:8080
# Only needed when tokens are minted through a different hostname than the API uses to reach Keycloak
# KEYCLOAK_ISSUER_URL=http://localhost:8080
KEYCLOAK_REALM=tenant-rbac-kit
KEYCLOAK_CLIENT_ID=tenant-rbac-api
KEYCLOAK_AUDIENCE=tenant-rbac-api
CASBIN_MODEL_PATH=casbin/model.conf
